# Lösenordet som krävs för att logga in. Sätt något långt och unikt.
APP_PASSWORD=byt-ut-detta-till-ett-langt-losenord

# Hemlighet för sessionscookies. Lämnas den tom genereras en och sparas i databasen.
# Sätter du den här kan du byta den för att logga ut alla enheter.
# Generera med: openssl rand -hex 32
SESSION_SECRET=

# Hur länge en inloggning gäller (dagar)
SESSION_DAYS=30

# Porten som containern exponerar på värden
HOST_PORT=8080

# Valfri kontaktadress i User-Agent-headern mot Nominatim/MET Norway vid väderhämtning.
# Faller tillbaka till ett standardvärde om den lämnas tom.
WEATHER_CONTACT=
